# Copie para keystore.properties (ignorado pelo git) e preencha com os seus dados.
# Use barras normais no caminho: em .properties a barra invertida é caractere de escape.
# Keystore PKCS12 (padrão do keytool): a senha da chave é a mesma da keystore.
storeFile=C:/caminho/fora/do/repo/enemigo-release.jks
storePassword=
keyAlias=enemigo
keyPassword=
