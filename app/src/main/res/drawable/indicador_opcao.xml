<?xml version="1.0" encoding="utf-8"?>
<!-- Bolinha da opção da meta: cheia com check quando marcada, vazia quando não. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/marca_primaria" />
                    <size
                        android:width="26dp"
                        android:height="26dp" />
                </shape>
            </item>
            <item
                android:bottom="5dp"
                android:drawable="@drawable/ic_check"
                android:left="5dp"
                android:right="5dp"
                android:top="5dp" />
        </layer-list>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="@dimen/largura_borda"
                android:color="@color/superficie_borda" />
            <size
                android:width="26dp"
                android:height="26dp" />
        </shape>
    </item>
</selector>
