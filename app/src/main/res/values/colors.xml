<?xml version="1.0" encoding="utf-8"?>
<!--
    Paleta "caderno de estudo" (modo claro). O modo escuro fica em values-night/colors.xml.
    Os nomes dizem a função da cor, não a cor em si: para trocar a marca, mude só os valores
    (veja "Personalizar a marca" no README).
-->
<resources>
    <!-- Marca -->
    <color name="marca_primaria">#3B4CCA</color>
    <color name="marca_primaria_escura">#2B3899</color>
    <color name="marca_primaria_suave">#E7EAFB</color>
    <color name="marca_primaria_texto">#3B4CCA</color>
    <color name="marca_sobre_primaria">#FFFFFF</color>

    <color name="marca_acento">#FFD43B</color>
    <color name="marca_acento_escuro">#E3B310</color>
    <color name="marca_acento_suave">#FFF5CC</color>
    <color name="marca_acento_texto">#946800</color>
    <color name="marca_sobre_acento">#3A2E00</color>

    <color name="marca_acerto">#12B886</color>
    <color name="marca_acerto_escuro">#0B8C66</color>
    <color name="marca_acerto_suave">#DDF6EE</color>
    <color name="marca_acerto_texto">#08765A</color>

    <color name="marca_erro">#F0525A</color>
    <color name="marca_erro_escuro">#C4343D</color>
    <color name="marca_erro_suave">#FDE6E7</color>
    <color name="marca_erro_texto">#B8262F</color>

    <color name="marca_ofensiva">#FF8A1F</color>
    <color name="marca_ofensiva_escura">#D96A0B</color>
    <color name="marca_ofensiva_miolo">#FFD43B</color>
    <color name="marca_ofensiva_texto">#B85A00</color>

    <!-- Superfícies e texto -->
    <color name="fundo">#F8F7F3</color>
    <color name="superficie">#FFFFFF</color>
    <color name="superficie_borda">#E6E3DA</color>
    <color name="superficie_variante">#EFEDE6</color>
    <color name="texto_principal">#1D2033</color>
    <color name="texto_secundario">#6A6E80</color>
    <color name="texto_sobre_cor">#FFFFFF</color>

    <color name="desativado">#E6E3DA</color>
    <color name="desativado_sombra">#D2CEC2</color>
    <color name="texto_desativado">#A09D93</color>

    <color name="bloqueado">#DEDBD2</color>
    <color name="bloqueado_sombra">#C6C2B6</color>
    <color name="bloqueado_icone">#A09D93</color>
    <color name="linha_trilha">#D6D2C7</color>
    <color name="balao_fundo">#FFFFFF</color>

    <!--
        Papel: texto-base e alternativas com figura/fórmula. Fica claro também no modo escuro,
        porque as figuras são desenhadas com "multiplicar" e as fórmulas têm tinta escura.
    -->
    <color name="papel">#FFFDF7</color>
    <color name="papel_borda">#E8E2D2</color>
    <color name="papel_margem">#F5B3B0</color>
    <color name="papel_texto">#1D2033</color>
    <color name="papel_texto_secundario">#6A6E80</color>
    <color name="papel_selecao">#E7EAFB</color>
    <color name="papel_acerto">#DDF6EE</color>
    <color name="papel_erro">#FDE6E7</color>

    <!--
        Mascote (Lia, a raposa). São apelidos das cores da marca: trocando a marca, a Lia
        acompanha, e no modo escuro ela usa as versões de values-night sozinha. O pelo é o laranja
        da ofensiva e o lenço é o azul-tinta. A tinta (olhos e boca) fica escura nos dois modos,
        porque é desenhada sobre o pelo e a máscara claros. Desenhos: tools/gerar_mascote.py.
    -->
    <color name="mascote_pelo">@color/marca_ofensiva</color>
    <color name="mascote_pelo_sombra">@color/marca_ofensiva_escura</color>
    <color name="mascote_mascara">@color/papel</color>
    <color name="mascote_lenco">@color/marca_primaria</color>
    <color name="mascote_lenco_sombra">@color/marca_primaria_escura</color>
    <color name="mascote_tinta">@color/papel_texto</color>
    <color name="mascote_brilho">@color/texto_sobre_cor</color>
    <color name="mascote_bochecha">@color/marca_erro</color>
    <color name="mascote_lingua">@color/marca_erro</color>
    <color name="mascote_lagrima">@color/marca_primaria</color>
    <color name="mascote_estrela">@color/marca_acento</color>
    <color name="mascote_estrela_borda">@color/marca_acento_escuro</color>
    <!-- Bolinhas de pensamento e "zzz": ficam fora do corpo, então seguem o texto da tela -->
    <color name="mascote_pensamento">@color/texto_secundario</color>

    <!--
        Avatar. Pele e cabelo são cores de pessoa (não mudam com a marca nem no modo escuro);
        o cabelo "colorido" e os fundos são apelidos das cores da marca. As peças vetoriais
        (avatar_*) são brancas e recebem a cor no Java, com tint (ver AvatarDrawable).
    -->
    <color name="avatar_pele_1">#FFE0C7</color>
    <color name="avatar_pele_2">#F7CFAE</color>
    <color name="avatar_pele_3">#EDB98A</color>
    <color name="avatar_pele_4">#D99E6A</color>
    <color name="avatar_pele_5">#C38451</color>
    <color name="avatar_pele_6">#A0673E</color>
    <color name="avatar_pele_7">#7E4E2E</color>
    <color name="avatar_pele_8">#5B3720</color>
    <color name="avatar_cabelo_1">#2B2421</color>
    <color name="avatar_cabelo_2">#5A3825</color>
    <color name="avatar_cabelo_3">#8E5A33</color>
    <color name="avatar_cabelo_4">#B8532C</color>
    <color name="avatar_cabelo_5">#E6BE6A</color>
    <color name="avatar_cabelo_6">@color/marca_primaria</color>
    <color name="avatar_fundo_1">@color/marca_primaria_suave</color>
    <color name="avatar_fundo_2">@color/marca_acento_suave</color>
    <color name="avatar_fundo_3">@color/marca_acerto_suave</color>
    <color name="avatar_fundo_4">@color/marca_erro_suave</color>
    <color name="avatar_fundo_5">@color/marca_primaria</color>
    <color name="avatar_fundo_6">@color/marca_acento</color>
    <color name="avatar_fundo_7">@color/area_natureza</color>
    <color name="avatar_fundo_8">@color/area_matematica</color>
    <color name="avatar_camisa">@color/papel</color>

    <!-- Áreas do ENEM: cor do cartão, sombra/texto escuro e conteúdo sobre a cor -->
    <color name="area_linguagens">#F2594B</color>
    <color name="area_linguagens_escura">#C8402F</color>
    <color name="area_linguagens_sobre">#FFFFFF</color>
    <color name="area_humanas">#F7A21B</color>
    <color name="area_humanas_escura">#B86E00</color>
    <color name="area_humanas_sobre">#3B2300</color>
    <color name="area_natureza">#0E9F96</color>
    <color name="area_natureza_escura">#0A7A73</color>
    <color name="area_natureza_sobre">#FFFFFF</color>
    <color name="area_matematica">#7950F2</color>
    <color name="area_matematica_escura">#5732C9</color>
    <color name="area_matematica_sobre">#FFFFFF</color>
</resources>
