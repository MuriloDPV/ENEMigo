<?xml version="1.0" encoding="utf-8"?>
<!-- Separador de unidade na trilha: faixa na cor da área com o número e os temas das lições. -->
<com.murilo.enemigo.ui.componente.CartaoRelevo xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/margem_tela"
    android:layout_marginTop="20dp"
    android:layout_marginBottom="12dp"
    app:raio="@dimen/raio_botao">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/face"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/raio_botao">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingVertical="14dp">

            <TextView
                android:id="@+id/txt_unidade"
                style="@style/Texto.Rotulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/txt_temas"
                style="@style/Texto.Titulo.Medio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</com.murilo.enemigo.ui.componente.CartaoRelevo>
