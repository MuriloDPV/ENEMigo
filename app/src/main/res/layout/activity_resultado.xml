<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:fillViewport="true">

    <!-- Sem recorte: a Lia pula para fora do halo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- A Lia num círculo com halo: comemorando (perfeito), feliz (concluída) ou pensando -->
        <FrameLayout
            android:id="@+id/halo_resultado"
            android:layout_width="156dp"
            android:layout_height="156dp"
            android:background="@drawable/bg_circulo"
            android:clipChildren="false">

            <com.murilo.enemigo.ui.componente.MascoteView
                android:id="@+id/mascote_resultado"
                android:layout_width="128dp"
                android:layout_height="128dp"
                android:layout_gravity="center" />
        </FrameLayout>

        <TextView
            android:id="@+id/txt_titulo"
            style="@style/Texto.Titulo.Grande"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/txt_acertos"
            style="@style/Texto.Secundario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <include
                android:id="@+id/card_xp"
                layout="@layout/item_resultado_stat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1" />

            <include
                android:id="@+id/card_ofensiva"
                layout="@layout/item_resultado_stat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Meta batida, desbloqueio, bônus e revisão: uma linha com ícone para cada -->
        <LinearLayout
            android:id="@+id/lista_mensagens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_contorno"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:visibility="gone" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="32dp" />

        <com.murilo.enemigo.ui.componente.BotaoRelevo
            android:id="@+id/btn_continuar"
            style="@style/Widget.ENEMigo.Botao.Primario"
            android:layout_width="match_parent"
            android:layout_height="@dimen/altura_botao"
            android:layout_marginTop="24dp"
            android:text="@string/btn_continuar" />

        <com.murilo.enemigo.ui.componente.BotaoRelevo
            android:id="@+id/btn_refazer"
            style="@style/Widget.ENEMigo.Botao.Neutro"
            android:layout_width="match_parent"
            android:layout_height="@dimen/altura_botao"
            android:layout_marginTop="@dimen/espaco_cards"
            android:text="@string/btn_refazer" />
    </LinearLayout>
</ScrollView>
