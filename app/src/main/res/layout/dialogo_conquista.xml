<?xml version="1.0" encoding="utf-8"?>
<!-- Detalhe de uma conquista, aberto ao tocar na medalha do Perfil. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="4dp">

    <ImageView
        android:id="@+id/img_medalha"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/txt_titulo"
        style="@style/Texto.Titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center" />

    <TextView
        android:id="@+id/txt_descricao"
        style="@style/Texto.Secundario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/txt_situacao"
        style="@style/Texto.Destaque"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_etiqueta"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:textSize="13sp" />
</LinearLayout>
