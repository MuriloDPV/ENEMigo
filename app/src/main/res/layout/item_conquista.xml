<?xml version="1.0" encoding="utf-8"?>
<!-- Uma conquista na grade do Perfil: medalha, título e descrição. Bloqueada, a medalha fica
     cinza e ganha o cadeado (ver ConquistaAdapter). -->
<com.murilo.enemigo.ui.componente.CartaoRelevo xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:clickable="true"
    android:focusable="true"
    app:raio="@dimen/raio_botao">

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.ENEMigo.Face.Contorno"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/raio_botao">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp">

            <FrameLayout
                android:layout_width="68dp"
                android:layout_height="68dp">

                <ImageView
                    android:id="@+id/img_medalha"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/img_cadeado"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_circulo"
                    android:backgroundTint="@color/bloqueado_icone"
                    android:importantForAccessibility="no"
                    android:padding="4dp"
                    android:src="@drawable/ic_cadeado"
                    android:visibility="gone"
                    app:tint="@color/texto_sobre_cor" />
            </FrameLayout>

            <TextView
                android:id="@+id/txt_titulo"
                style="@style/Texto.Destaque"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:gravity="center"
                android:lines="2"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txt_descricao"
                style="@style/Texto.Secundario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:lines="3"
                android:textSize="11sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</com.murilo.enemigo.ui.componente.CartaoRelevo>
