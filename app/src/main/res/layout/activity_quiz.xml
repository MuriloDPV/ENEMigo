<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo">

    <!-- Topo: fechar, progresso e vidas -->
    <LinearLayout
        android:id="@+id/topo_quiz"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_fechar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/fechar"
            android:src="@drawable/ic_fechar"
            app:tint="@color/texto_secundario" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_quiz"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:max="5"
            app:trackCornerRadius="5dp"
            app:trackThickness="10dp" />

        <TextView
            android:id="@+id/txt_vidas_quiz"
            style="@style/Texto.Status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:drawablePadding="4dp"
            android:gravity="center_vertical"
            android:textColor="@color/marca_erro_texto"
            android:textSize="17sp"
            app:drawableStartCompat="@drawable/ic_coracao" />
    </LinearLayout>

    <!-- Conteúdo da questão -->
    <ScrollView
        android:id="@+id/scroll_quiz"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/area_inferior"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topo_quiz">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/margem_tela"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txt_contador"
                    style="@style/Texto.Rotulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/txt_fonte"
                    style="@style/Texto.Secundario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_fonte"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Texto-base no cartão de papel (claro também no modo escuro) -->
            <FrameLayout
                android:id="@+id/card_texto_base"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_papel"
                android:paddingStart="28dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/txt_texto_base"
                    style="@style/Texto.Leitura"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </FrameLayout>

            <!-- Só aparece quando a questão tem figura -->
            <TextView
                android:id="@+id/txt_dica_figura"
                style="@style/Texto.Secundario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/quiz_dica_figura"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txt_enunciado"
                style="@style/Texto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:lineSpacingMultiplier="1.2"
                android:textSize="17sp" />

            <include
                android:id="@+id/alt_a"
                layout="@layout/item_alternativa" />

            <include
                android:id="@+id/alt_b"
                layout="@layout/item_alternativa" />

            <include
                android:id="@+id/alt_c"
                layout="@layout/item_alternativa" />

            <include
                android:id="@+id/alt_d"
                layout="@layout/item_alternativa" />

            <include
                android:id="@+id/alt_e"
                layout="@layout/item_alternativa" />
        </LinearLayout>
    </ScrollView>

    <!-- Área inferior: VERIFICAR ou painel de feedback -->
    <LinearLayout
        android:id="@+id/area_inferior"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:id="@+id/divisor_inferior"
            android:layout_width="match_parent"
            android:layout_height="@dimen/largura_borda"
            android:background="@color/superficie_borda" />

        <com.murilo.enemigo.ui.componente.BotaoRelevo
            android:id="@+id/btn_verificar"
            style="@style/Widget.ENEMigo.Botao.Primario"
            android:layout_width="match_parent"
            android:layout_height="@dimen/altura_botao"
            android:layout_margin="16dp"
            android:enabled="false"
            android:text="@string/btn_verificar" />

        <!-- Sobe de baixo depois do VERIFICAR. Sem recorte: a Lia pula para a margem de cima. -->
        <LinearLayout
            android:id="@+id/painel_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/margem_tela"
            android:paddingTop="18dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- A Lia reage: feliz e pulando no acerto, triste e tremendo no erro -->
                <com.murilo.enemigo.ui.componente.MascoteView
                    android:id="@+id/mascote_feedback"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="-6dp" />

                <TextView
                    android:id="@+id/txt_feedback_titulo"
                    style="@style/Texto.Titulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:accessibilityLiveRegion="polite" />
            </LinearLayout>

            <!-- A explicação rola se passar de 160dp -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <ScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constrainedHeight="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHeight_max="160dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/txt_explicacao"
                        style="@style/Texto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingMultiplier="1.2"
                        android:textSize="15sp" />
                </ScrollView>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.murilo.enemigo.ui.componente.BotaoRelevo
                android:id="@+id/btn_continuar"
                style="@style/Widget.ENEMigo.Botao.Acerto"
                android:layout_width="match_parent"
                android:layout_height="@dimen/altura_botao"
                android:layout_marginTop="16dp"
                android:text="@string/btn_continuar" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
