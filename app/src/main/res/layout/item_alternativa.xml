<?xml version="1.0" encoding="utf-8"?>
<!-- Alternativa do quiz (incluída 5 vezes): letra no círculo e texto, em relevo. As cores de cada
     estado (normal, selecionada, correta, errada) são aplicadas na QuizActivity. -->
<com.murilo.enemigo.ui.componente.CartaoRelevo xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp"
    android:clickable="true"
    android:focusable="true"
    app:raio="@dimen/raio_botao">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/face_alt"
        style="@style/Widget.ENEMigo.Face.Contorno"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/raio_botao">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/txt_letra"
                style="@style/Texto.Titulo"
                android:layout_width="@dimen/tamanho_letra_alternativa"
                android:layout_height="@dimen/tamanho_letra_alternativa"
                android:gravity="center"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txt_texto"
                style="@style/Texto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:lineSpacingMultiplier="1.15" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</com.murilo.enemigo.ui.componente.CartaoRelevo>
