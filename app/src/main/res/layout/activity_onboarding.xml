<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:fillViewport="true">

    <!-- Sem recorte: a Lia pula para a margem de cima -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <!-- A Lia se apresenta num balão de fala -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.murilo.enemigo.ui.componente.MascoteView
                android:id="@+id/mascote"
                android:layout_width="104dp"
                android:layout_height="104dp"
                app:expressao="feliz" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_balao"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/txt_titulo"
                        style="@style/Texto.Titulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/txt_subtitulo"
                        style="@style/Texto.Secundario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- Por cima da borda do balão, para a ponta "sair" dele -->
                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="18dp"
                    android:layout_gravity="start|center_vertical"
                    android:importantForAccessibility="no"
                    android:src="@drawable/balao_ponta_esquerda" />
            </FrameLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_nome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:hint="@string/onboarding_hint_nome"
            app:counterEnabled="true"
            app:counterMaxLength="20">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edt_nome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="20" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/Texto.Titulo.Medio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/onboarding_pergunta_meta" />

        <include layout="@layout/layout_opcoes_meta" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <com.murilo.enemigo.ui.componente.BotaoRelevo
            android:id="@+id/btn_comecar"
            style="@style/Widget.ENEMigo.Botao.Primario"
            android:layout_width="match_parent"
            android:layout_height="@dimen/altura_botao"
            android:text="@string/btn_comecar" />
    </LinearLayout>
</ScrollView>
