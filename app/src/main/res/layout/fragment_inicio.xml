<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/margem_tela"
        android:paddingTop="12dp"
        android:paddingBottom="28dp">

        <!-- Topo: marca e status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:importantForAccessibility="no"
                android:src="@drawable/marca_logo" />

            <TextView
                style="@style/Texto.Titulo.Medio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="@color/marca_primaria_texto" />

            <include
                android:id="@+id/status"
                layout="@layout/layout_status" />
        </LinearLayout>

        <!-- Saudação com o avatar do aluno (toque para abrir o Perfil) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/img_avatar"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_avatar_perfil" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txt_saudacao"
                    style="@style/Texto.Titulo.Grande"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    style="@style/Texto.Secundario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/saudacao_subtitulo"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Meta diária -->
        <com.murilo.enemigo.ui.componente.CartaoRelevo
            android:id="@+id/card_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ENEMigo.Face.Contorno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/circulo_meta"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_circulo"
                            android:backgroundTint="@color/marca_acento_suave">

                            <ImageView
                                android:id="@+id/img_meta"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_alvo"
                                app:tint="@color/marca_acento_texto" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Texto.Destaque"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/meta_diaria" />

                            <TextView
                                android:id="@+id/txt_meta"
                                style="@style/Texto.Secundario"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:max="50"
                        app:indicatorColor="@color/marca_acento"
                        app:trackThickness="14dp"
                        app:trackCornerRadius="7dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </com.murilo.enemigo.ui.componente.CartaoRelevo>

        <!-- Aparece no lugar dos cartões se o questoes.json não puder ser lido -->
        <TextView
            android:id="@+id/txt_erro_questoes"
            style="@style/Texto.Destaque"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/erro_carregar_questoes"
            android:textColor="@color/marca_erro_texto"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/grade_areas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Texto.Titulo.Medio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/areas_do_enem" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_cards"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/card_linguagens"
                    layout="@layout/item_area"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/altura_card_area"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/card_humanas"
                    layout="@layout/item_area"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/altura_card_area"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_cards"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/card_natureza"
                    layout="@layout/item_area"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/altura_card_area"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/card_matematica"
                    layout="@layout/item_area"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/altura_card_area"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
