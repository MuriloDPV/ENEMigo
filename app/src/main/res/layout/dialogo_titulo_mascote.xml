<?xml version="1.0" encoding="utf-8"?>
<!-- Título dos diálogos com a Lia (vidas, notificações): ela em cima e o título embaixo (ver Dialogos). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="20dp">

    <com.murilo.enemigo.ui.componente.MascoteView
        android:id="@+id/mascote_dialogo"
        android:layout_width="96dp"
        android:layout_height="96dp"
        app:expressao="sem_vidas" />

    <TextView
        android:id="@+id/txt_titulo_dialogo"
        style="@style/Texto.Titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textSize="22sp" />
</LinearLayout>
