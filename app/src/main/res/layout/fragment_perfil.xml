<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/margem_tela"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <!-- Título e a engrenagem das Configurações -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Texto.Titulo.Grande"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/aba_perfil" />

            <ImageButton
                android:id="@+id/btn_configuracoes"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="-12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/configuracoes_titulo"
                android:src="@drawable/ic_settings"
                app:tint="@color/texto_secundario" />
        </LinearLayout>

        <!-- Nome, nível e barra de XP até o próximo nível -->
        <com.murilo.enemigo.ui.componente.CartaoRelevo
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.ENEMigo.Face.Contorno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Avatar com o lápis: toque para editar -->
                    <FrameLayout
                        android:id="@+id/btn_avatar"
                        android:layout_width="108dp"
                        android:layout_height="108dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/cd_avatar_editar"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/img_avatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no" />

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="bottom|end"
                            android:background="@drawable/bg_circulo"
                            android:backgroundTint="@color/marca_primaria"
                            android:importantForAccessibility="no"
                            android:padding="7dp"
                            android:src="@drawable/ic_editar"
                            app:tint="@color/marca_sobre_primaria" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/txt_nome"
                        style="@style/Texto.Titulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/txt_nivel"
                        style="@style/Texto.Destaque"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_etiqueta"
                        android:backgroundTint="@color/marca_primaria_suave"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:textColor="@color/marca_primaria_texto"
                        android:textSize="14sp" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_nivel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:max="100"
                        app:indicatorColor="@color/marca_acento"
                        app:trackCornerRadius="7dp"
                        app:trackThickness="14dp" />

                    <TextView
                        android:id="@+id/txt_xp_proximo"
                        style="@style/Texto.Secundario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </com.murilo.enemigo.ui.componente.CartaoRelevo>

        <TextView
            style="@style/Texto.Titulo.Medio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/perfil_estatisticas" />

        <!-- Estatísticas: grade de 2 colunas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="-6dp"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <include
                android:id="@+id/stat_xp"
                layout="@layout/item_estatistica" />

            <include
                android:id="@+id/stat_ofensiva"
                layout="@layout/item_estatistica" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="-6dp"
            android:orientation="horizontal">

            <include
                android:id="@+id/stat_maior_ofensiva"
                layout="@layout/item_estatistica" />

            <include
                android:id="@+id/stat_licoes"
                layout="@layout/item_estatistica" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="-6dp"
            android:orientation="horizontal">

            <include
                android:id="@+id/stat_respondidas"
                layout="@layout/item_estatistica" />

            <include
                android:id="@+id/stat_taxa"
                layout="@layout/item_estatistica" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="-6dp"
            android:orientation="horizontal">

            <include
                android:id="@+id/stat_tempo_medio"
                layout="@layout/item_estatistica" />

            <include
                android:id="@+id/stat_minutos_hoje"
                layout="@layout/item_estatistica" />
        </LinearLayout>

        <!-- Conquistas (C3): grade de 3 colunas com as medalhas -->
        <TextView
            android:id="@+id/txt_conquistas_titulo"
            style="@style/Texto.Titulo.Medio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp" />

        <TextView
            android:id="@+id/txt_conquistas_vazio"
            style="@style/Texto.Secundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/perfil_conquistas_vazio"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_conquistas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="-5dp"
            android:layout_marginTop="6dp"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />
    </LinearLayout>
</ScrollView>
