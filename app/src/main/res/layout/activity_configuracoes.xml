<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:orientation="vertical">

    <!-- Cabeçalho: voltar e título -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="@dimen/margem_tela">

        <ImageButton
            android:id="@+id/btn_voltar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/voltar"
            android:src="@drawable/ic_voltar"
            app:tint="@color/texto_principal" />

        <TextView
            style="@style/Texto.Titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/configuracoes_titulo" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/margem_tela"
            android:paddingTop="8dp"
            android:paddingBottom="28dp">

            <TextView
                style="@style/Texto.Rotulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/config_secao_nome" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_nome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/onboarding_hint_nome"
                app:counterEnabled="true"
                app:counterMaxLength="20">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edt_nome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="20" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Texto.Rotulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/meta_diaria" />

            <include layout="@layout/layout_opcoes_meta" />

            <TextView
                style="@style/Texto.Rotulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/config_secao_som" />

            <!-- Som e vibração num cartão, separados por uma linha -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_contorno"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_som"
                    style="@style/Texto.Destaque"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/config_som" />

                <TextView
                    style="@style/Texto.Secundario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="64dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/config_som_desc"
                    android:textSize="13sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/largura_borda"
                    android:background="@color/superficie_borda" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_vibracao"
                    style="@style/Texto.Destaque"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/config_vibracao" />

                <TextView
                    style="@style/Texto.Secundario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="64dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/config_vibracao_desc"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                style="@style/Texto.Rotulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/config_secao_lembrete" />

            <!-- Lembrete diário: liga/desliga e o horário, separados por uma linha -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_contorno"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_lembrete"
                    style="@style/Texto.Destaque"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/config_lembrete" />

                <TextView
                    style="@style/Texto.Secundario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="64dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/config_lembrete_desc"
                    android:textSize="13sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/largura_borda"
                    android:background="@color/superficie_borda" />

                <!-- Tocar na linha abre o relógio -->
                <LinearLayout
                    android:id="@+id/linha_horario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Texto.Destaque"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/config_lembrete_horario" />

                    <TextView
                        android:id="@+id/txt_horario"
                        style="@style/Texto.Destaque"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/marca_primaria_texto" />
                </LinearLayout>

                <!-- Só aparece com o lembrete ligado e as notificações bloqueadas no Android -->
                <TextView
                    android:id="@+id/txt_notificacoes_bloqueadas"
                    style="@style/Texto.Secundario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:text="@string/config_notificacoes_bloqueadas"
                    android:textColor="@color/marca_erro_texto"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <com.murilo.enemigo.ui.componente.BotaoRelevo
                android:id="@+id/btn_salvar"
                style="@style/Widget.ENEMigo.Botao.Primario"
                android:layout_width="match_parent"
                android:layout_height="@dimen/altura_botao"
                android:layout_marginTop="24dp"
                android:text="@string/btn_salvar" />

            <TextView
                style="@style/Texto.Rotulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/config_secao_progresso" />

            <TextView
                style="@style/Texto.Secundario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/config_reset_explicacao" />

            <com.murilo.enemigo.ui.componente.BotaoRelevo
                android:id="@+id/btn_resetar"
                style="@style/Widget.ENEMigo.Botao.Erro"
                android:layout_width="match_parent"
                android:layout_height="@dimen/altura_botao"
                android:layout_marginTop="12dp"
                android:text="@string/btn_resetar" />

            <TextView
                style="@style/Texto.Rotulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/config_secao_sobre" />

            <TextView
                android:id="@+id/txt_sobre"
                style="@style/Texto.Secundario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
