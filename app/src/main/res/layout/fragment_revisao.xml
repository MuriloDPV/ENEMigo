<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/margem_tela"
    android:paddingTop="20dp">

    <TextView
        style="@style/Texto.Titulo.Grande"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/caderno_titulo" />

    <TextView
        android:id="@+id/txt_contador"
        style="@style/Texto.Secundario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_dica_vida"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_coracao" />

        <TextView
            style="@style/Texto.Destaque"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/caderno_apoio"
            android:textColor="@color/marca_erro_texto"
            android:textSize="14sp" />
    </LinearLayout>

    <com.murilo.enemigo.ui.componente.BotaoRelevo
        android:id="@+id/btn_revisar"
        style="@style/Widget.ENEMigo.Botao.Primario"
        android:layout_width="match_parent"
        android:layout_height="@dimen/altura_botao"
        android:layout_marginTop="16dp"
        android:text="@string/btn_revisar_agora" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_caderno"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

    <LinearLayout
        android:id="@+id/layout_vazio"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:background="@drawable/bg_circulo"
            android:backgroundTint="@color/marca_acerto_suave">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_check"
                app:tint="@color/marca_acerto" />
        </FrameLayout>

        <TextView
            style="@style/Texto.Titulo.Medio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/caderno_vazio_titulo" />

        <TextView
            style="@style/Texto.Secundario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/caderno_vazio"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
