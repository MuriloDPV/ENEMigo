<?xml version="1.0" encoding="utf-8"?>
<!-- Pílulas de ofensiva, XP e vidas, reaproveitadas com <include> no Início e na Trilha. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/txt_ofensiva"
        style="@style/Widget.ENEMigo.Pilula"
        app:drawableStartCompat="@drawable/ic_fogo"
        android:textColor="@color/marca_ofensiva_texto" />

    <TextView
        android:id="@+id/txt_xp"
        style="@style/Widget.ENEMigo.Pilula"
        android:layout_marginStart="6dp"
        app:drawableStartCompat="@drawable/ic_estrela"
        android:textColor="@color/marca_acento_texto" />

    <TextView
        android:id="@+id/txt_vidas"
        style="@style/Widget.ENEMigo.Pilula"
        android:layout_marginStart="6dp"
        app:drawableStartCompat="@drawable/ic_coracao"
        android:textColor="@color/marca_erro_texto" />

</LinearLayout>
