<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Vibração curta ao errar (C10), que pode ser desligada nas Configurações -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Lembrete diário da ofensiva (pedida no Android 13+ depois da primeira lição) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ENEMigo">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.ENEMigo.Abertura">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.OnboardingActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.TrilhaActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.QuizActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.ResultadoActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.AvatarActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".ui.CelebracaoActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.ENEMigo.Celebracao" />

        <activity
            android:name=".ui.ConfiguracoesActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
